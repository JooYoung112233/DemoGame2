# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE
.vs/
.vscode/
.idea/
*.DotSettings.user

# OS
.DS_Store
Thumbs.db
desktop.ini

# Builds / packages
*.apk
*.aab
*.app
*.exe
*.unitypackage
crashlytics-build.properties
sysinfo.txt

# Asset Store tools
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*
